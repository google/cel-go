load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

go_library(
    name = "go_default_library",
    srcs = ["alias.go"],
    importpath = "github.com/google/cel-go/ext/security/jwt",
    deps = [
        "@dev_cel_cel_go//cel:go_default_library",
        "@dev_cel_cel_go_ext_security//jwt:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = ["alias_test.go"],
    deps = [
        ":go_default_library",
        "@dev_cel_cel_go//cel:go_default_library",
    ],
)
