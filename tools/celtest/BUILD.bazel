load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

go_library(
    name = "go_default_library",
    srcs = ["alias.go"],
    importpath = "github.com/google/cel-go/tools/celtest",
    deps = [
        "//tools/compiler:go_default_library",
        "@dev_cel_cel_go//cel:go_default_library",
        "@dev_cel_cel_go//common/types/ref:go_default_library",
        "@dev_cel_cel_go_tools//celtest:go_default_library",
        "@org_golang_google_protobuf//types/descriptorpb:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = ["alias_test.go"],
    deps = [
        ":go_default_library",
    ],
)
